{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slide Up",
  "version": "0.1.0",
  "identifier": "com.bhs.slide-up",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Slide Up",
        "width": 1200,
        "height": 720,
        "minWidth": 340,
        "minHeight": 220,
        "center": true,
        "decorations": false,
        "dragDropEnabled": true,
        "backgroundColor": "#080D1D",
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$RESOURCE/**",
          "$TEMP/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "licenseFile": "../LICENSE",
    "resources": [
      "resources/libmpv-2.dll",
      "resources/vulkan-1.dll",
      "binaries/onnxruntime.dll"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico"
      }
    },
    "fileAssociations": [
      {
        "ext": ["mp4", "mkv", "avi", "mov", "webm", "wmv", "flv", "ts", "m4v", "3gp"],
        "name": "Video File",
        "description": "Video Media File",
        "role": "Viewer"
      },
      {
        "ext": ["mp3", "flac", "wav", "m4a", "aac", "ogg", "opus", "wma"],
        "name": "Audio File",
        "description": "Audio Media File",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1ODVENEYxQjYwNzFDRUMKUldUc0hBZTI4ZFNGMWJkbDZlL0ZwK2tVOXhMRUwyZWliSkRaS2RlWFlwMnplUFprVVNhUS80QVEK",
      "endpoints": [
        "https://github.com/bhsorg/slide-up/releases/latest/download/latest.json"
      ]
    }
  }
}
