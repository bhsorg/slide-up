{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "slide-up",
  "version": "0.1.0",
  "identifier": "com.bhs.slide-up",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Slide Up",
        "width": 1200,
        "height": 720,
        "minWidth": 340,
        "minHeight": 220,
        "center": true,
        "decorations": false,
        "dragDropEnabled": true,
        "backgroundColor": "#080D1D",
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$RESOURCE/**", "$TEMP/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/libmpv-2.dll", "resources/vulkan-1.dll", "binaries/onnxruntime.dll"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
